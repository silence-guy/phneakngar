# =============================================================================
# ភ្នាក់ងារ — Environment Variables
# =============================================================================
# Copy this file to .env and customize for your local development setup.
# Most variables are optional; email-domain values must be explicit and synchronized.
#
# The dev:cli script auto-sets PHNEAKNGAR_SERVER_URL and PHNEAKNGAR_PROJECT_ROOT,
# so you typically only need .env overrides for non-default agent paths or
# tuning chhlat behavior.
#
# For auth secrets (Better Auth, OAuth), see src/web/.dev.vars.example.
# =============================================================================


# =============================================================================
# Server & Project
# =============================================================================

# API server URL. Set automatically by `pnpm dev:cli`.
# Set this to the operator-provided control-plane origin for another environment.
# PHNEAKNGAR_SERVER_URL=http://localhost:3000

# Project root directory. Set automatically by `pnpm dev:cli`.
# Used to locate .phneakngar/ config dir in dev mode.
# PHNEAKNGAR_PROJECT_ROOT=/path/to/phneakngar

# Explicit local email domain for agent handles. cieee.xyz is live-testing only.
PHNEAKNGAR_DOMAIN=phneakngar.invalid


# =============================================================================
# Local Dev Service URLs & Ports
# =============================================================================
# Used for service-binding fallbacks during local development.

# WebSocket Durable Object worker URL (must match src/ws-do/wrangler.toml port)
# DEV_WS_DO_URL=http://localhost:8789

# Email worker URL (must match src/email-worker/wrangler.toml port)
# DEV_EMAIL_WORKER_URL=http://localhost:8787

# Internal Worker secrets are generated and synchronized by `pnpm predev` in
# src/web/.dev.vars, src/email-worker/.dev.vars, and src/ws-do/.dev.vars.
# EMAIL_NOTIFY_SECRET=
# WS_SERVICE_SECRET=

# Chhlat health check server port
# PHNEAKNGAR_HEALTH_PORT=19514


# =============================================================================
# Chhlat — Identity
# =============================================================================

# Unique chhlat identifier (defaults to hostname, suffixed with profile if set)
# PHNEAKNGAR_CHHLAT_ID=my-machine

# Human-readable device name shown in the web UI
# PHNEAKNGAR_CHHLAT_DEVICE_NAME=My MacBook

# Display name for the agent runtime
# PHNEAKNGAR_AGENT_RUNTIME_NAME=Local Agent


# =============================================================================
# Chhlat — Storage
# =============================================================================

# Directory where the chhlat stores workspace checkouts
# Dev default: <project-root>/.phneakngar/workspaces/
# Prod default: ~/.phneakngar/workspaces
# PHNEAKNGAR_WORKSPACES_ROOT=~/.phneakngar/workspaces


# =============================================================================
# Chhlat — Timing
# =============================================================================

# How often the chhlat polls for new tasks (duration string: e.g. 3s, 500ms)
# PHNEAKNGAR_CHHLAT_POLL_INTERVAL=3s

# Maximum time a single agent task can run before being killed
# PHNEAKNGAR_AGENT_TIMEOUT=2h

# Maximum number of tasks the chhlat runs concurrently
# PHNEAKNGAR_CHHLAT_MAX_CONCURRENT_TASKS=20

# Keep shell environment variables across tasks
# PHNEAKNGAR_KEEP_ENV_AFTER_TASK=false

# Graceful shutdown timeout before force-exit (ms)
# PHNEAKNGAR_SHUTDOWN_TIMEOUT_MS=5000

# Message batch size — how many messages to buffer before flushing to server
# PHNEAKNGAR_MESSAGE_BATCH_SIZE=20

# Message flush interval — max time before a partial batch is sent (ms)
# PHNEAKNGAR_MESSAGE_FLUSH_INTERVAL_MS=100

# Time (seconds) before a dispatched task is considered stale and failed
# PHNEAKNGAR_STALE_DISPATCH_TIMEOUT_S=20


# =============================================================================
# Shared Timing Constants
# =============================================================================
# Used by both web and CLI for real-time status tracking.

# Client-side poll interval (ms)
# POLL_INTERVAL_MS=3000

# Time (ms) without liveness update before a runtime is considered offline
# OFFLINE_THRESHOLD_MS=9000

# How often the web UI polls for new events (ms)
# EVENT_POLL_INTERVAL_MS=2000


# =============================================================================
# Web Client (browser-side, requires NEXT_PUBLIC_ prefix)
# =============================================================================

# App URL used by auth client (CI default: http://localhost:3000; documented local UI: http://localhost:15210)
# NEXT_PUBLIC_APP_URL=http://localhost:15210

# Browser-visible agent email domain; must match PHNEAKNGAR_DOMAIN.
NEXT_PUBLIC_PHNEAKNGAR_DOMAIN=phneakngar.invalid

# Canonical public origin used for metadata and social image resolution.
# Production falls back to https://phneakngar.ai; custom domains must set this explicitly.
# Must be an http(s) origin without a path, query, or fragment.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Mock network mode — adds artificial delay to all API requests (dev only)
# Useful for testing loading states, skeletons, and race conditions.
# NEXT_PUBLIC_MOCK_NETWORK=true

# Delay in milliseconds applied to each API request when mock network is enabled (default: 300)
# NEXT_PUBLIC_MOCK_NETWORK_DELAY_MS=300

# WebSocket Durable Object port (dev only, must match src/ws-do/wrangler.toml)
# NEXT_PUBLIC_WS_DO_PORT=8789

# Initial reconnect delay (ms), doubles on each retry
# NEXT_PUBLIC_WS_RECONNECT_DELAY_MS=1000

# Maximum reconnect delay cap (ms)
# NEXT_PUBLIC_WS_RECONNECT_MAX_DELAY_MS=30000


# =============================================================================
# Agent Paths
# =============================================================================
# Paths to CLI agent binaries. Override if not on $PATH.

# PHNEAKNGAR_CLAUDE_PATH=claude
# PHNEAKNGAR_CODEX_PATH=codex
# PHNEAKNGAR_OPENCODE_PATH=opencode
# PHNEAKNGAR_GROK_PATH=grok


# =============================================================================
# Agent Models
# =============================================================================
# Override the default model for each agent runtime.

# PHNEAKNGAR_CLAUDE_MODEL=
# PHNEAKNGAR_CODEX_MODEL=
# PHNEAKNGAR_OPENCODE_MODEL=
# PHNEAKNGAR_GROK_MODEL=
# Grok uses local auth: `grok login` (subscription) or XAI_API_KEY — not server secrets.


# =============================================================================
# Logging
# =============================================================================

# Log level: error | warn | info | debug
# PHNEAKNGAR_LOG_LEVEL=info
