# =============================================================================
# Cloudflare Worker Bindings — Local Development
# =============================================================================
# Copy this file to .dev.vars and fill in your values.
# Wrangler reads .dev.vars automatically for local dev secrets.
# NEVER commit .dev.vars — it contains real secrets.
# =============================================================================

NODE_ENV=development

# Session signing secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encryption key for IMAP/SMTP credentials (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Shared secret for authenticated web/email Worker communication in both directions.
EMAIL_NOTIFY_SECRET=

# Shared secret for authenticated web/WebSocket Worker communication.
WS_SERVICE_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Device Code Flow — comma-separated allowed client IDs
DEVICE_CLIENT_IDS=phneakngar-cli

# Local agent email domain. cieee.xyz is the current live-testing deployment only.
# Keep the server and browser values identical.
PHNEAKNGAR_DOMAIN=phneakngar.invalid
NEXT_PUBLIC_PHNEAKNGAR_DOMAIN=phneakngar.invalid
NEXT_PUBLIC_PHNEAKNGAR_ENVIRONMENT=development
